global:
  scrape_interval: 30s

scrape_configs:
  - job_name: 'victoriametrics'
    static_configs:
      - targets: ['localhost:{{ victoriametrics_port }}']

  - job_name: 'alertmanager'
    static_configs:
      - targets: ['localhost:{{ alertmanager_port }}']

  - job_name: 'proxmox_host'
    static_configs:
      - targets: ['{{ proxmox_host_ip }}:9100']

  - job_name: 'k3s_cluster'
    static_configs:
      - targets:
{% for node in k3s_nodes %}
          - '{{ node }}:9100'
{% endfor %}